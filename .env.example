# Leave DATABASE_URL unset to use the local SQLite file (data/fertilizer.db).
#
# To write to a free hosted Postgres instead, copy this file to .env and paste
# the connection string. Neon is the better fit for a side project: Supabase
# pauses a free project after a week of inactivity, Neon does not.
#
#   Neon      https://neon.tech       0.5 GB/project, up to 100 projects
#   Supabase  https://supabase.com    500 MB, but auto-pauses when idle
#
# Postgres also needs the driver:  pip install "psycopg[binary]"

# DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
